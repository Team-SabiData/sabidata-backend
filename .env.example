# =============================================================================
# SabiData backend — configuration d'environnement
# =============================================================================

# ── Auth (JWT) ──────────────────────────────────────────────────────────────
# openssl rand -hex 32
JWT_SECRET=GENERE_AVEC_openssl_rand_-hex_32

# ── Runtime ─────────────────────────────────────────────────────────────────
# production sur Railway ; laisser vide en local
# NODE_ENV=production
# Premier go-live sans SMS réel (OTP 0000) — retirer avant ouverture publique
# STAGING=true
# PORT fourni par Railway (défaut 3000 en local)
# PORT=3000

# Origines CORS (admin Vercel). Vide ou * = réfléchir l'origine.
# CORS_ORIGINS=https://sabidata-admin.vercel.app

# ── Base de données ─────────────────────────────────────────────────────────
# Local : DATABASE=pg → PGlite
DATABASE=pg
# Prod (Neon) — prioritaire sur DATABASE=pg
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/sabidata?sslmode=require

# ── Stockage audio ──────────────────────────────────────────────────────────
AUDIO_DIR=var/audio
# Prod (Cloudflare R2) — obligatoire si NODE_ENV=production
# S3_BUCKET=sabi-audio
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=REMPLACE
# S3_SECRET_ACCESS_KEY=REMPLACE
# S3_REGION=auto
# S3_PREFIX=clips/

# ── Vonage SMS ──────────────────────────────────────────────────────────────
VONAGE_API_KEY=REMPLACE_PAR_TA_CLE
VONAGE_API_SECRET=REMPLACE_PAR_TON_SECRET
VONAGE_FROM=SabiData
# true en prod publique ; false + STAGING=true ok pour premier déploiement
SMS_ENABLED=false

# ── bootstrap-admin (one-shot) ──────────────────────────────────────────────
# ADMIN_EMAIL=ops@sabidata.bf
# ADMIN_PASSWORD=change-me-now-8chars
# ADMIN_NAME=Ops SabiData
